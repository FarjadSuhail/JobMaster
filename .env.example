# JobMaster configuration — read by docker compose (see README.md for details).

# ---- AI provider ----
# openai | anthropic  (adding more vendors: see README)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# "mock" = run without any API key (canned AI responses, no credits used).
# Set to empty (SPRING_PROFILES_ACTIVE=) for real AI — and fill in the API key above.
SPRING_PROFILES_ACTIVE=mock

# ---- database ----
DB_NAME=jobmaster
DB_USER=postgres
DB_PASSWORD=password

# Dashboard stats ignore applications created before this date.
DASHBOARD_START_DATE=2026-07-08

# Timezone for date stamps (applied/interviewed dates, monthly usage buckets).
TZ=Europe/Berlin

# How often portals are checked (Spring cron, Europe/Berlin). Daily 11:00 by
# default; on an always-on server use every 2h during the day to apply early:
#   WATCHER_CRON=0 0 7-21/2 * * *
WATCHER_CRON=0 0 11 * * *

# ---- Telegram notifications (optional) ----
# 1. In Telegram, message @BotFather -> /newbot -> pick a name -> copy the token.
# 2. Open your new bot's chat and send it any message (e.g. "hi").
# 3. Visit https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates in a browser and
#    copy the number at "chat":{"id": ... }.
# 4. Fill both values, restart, then click nothing: verify with
#    curl -X POST localhost:8080/api/watch/telegram-test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- host ports ----
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_HOST_PORT=5433

# ---- production deployment only (compose.prod.yaml) — see docs/deployment-plan.md ----
# Leave these blank for local dev; BIND_ADDRESS defaults to 127.0.0.1 either way
# (set BIND_ADDRESS=0.0.0.0 here only if you want LAN access during local dev).
BIND_ADDRESS=
DOMAIN=
ACME_EMAIL=
BASIC_AUTH_USER=
BASIC_AUTH_HASH=
